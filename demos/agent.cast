[16.137994, "o", "> build · claude-sonnet-4-6\r\n"]
[17.307013, "o", "\u001b[0m→ \u001b[0mRead demos \r\n"]
[17.307059, "o", "\u001b[0m→ \u001b[0mRead examples/rbac-escalation \r\n"]
