[30.285127, "o", "\u001b[0m$ \u001b[0mcat /tmp/opencode/preflight-report.json\r\n{\r\n  \"schema_version\": \"1.0.0\",\r\n  \"tool\": {\r\n    \"name\": \"helm-agent-preflight\",\r\n    \"version\": \"v0.1.0\",\r\n    \"commit\": \"91250d3\"\r\n  },\r\n  \"operation\": {\r\n    \"type\": \"upgrade\",\r\n    \"offline_mode\": true,\r\n    \"timestamp_utc\": \"2026-11-13T03:38:30Z\",\r\n    \"no_deployment_occurred\": true\r\n  },\r\n  \"verdict\": \"BLOCK\",\r\n  \"inputs\": {\r\n    \"from_chart\": {\r\n      \"path\": \"examples/rbac-escalation/baseline\",\r\n      \"sha256\": \"543dc1f964334097556d44ba4911db9f427c315d6788a1a3fd224d5976c3c53c\"\r\n    },\r\n    \"to_chart\": {\r\n      \"path\": \"examples/rbac-escalation/candidate\",\r\n      \"sha256\": \"7458c7c410802d7d55348bd0beb52a98666ecd0a0898a109f102bf3c7dfd0419\"\r\n    },\r\n    \"values_file\": {\r\n      \"path\": \"\",\r\n      \"sha256\": \"\"\r\n    },\r\n    \"release_name\": \"webapp\",\r\n    \"namespace\": \"default\",\r\n    \"kubernetes_version\": \"1.37\",\r\n    \"policy_file\": {\r\n      \"path\": \"embedded:conftest-rego-baseline\",\r\n      \"sha256\": \"\"\r\n    }\r\n  },\r\n  \"rendering\": {\r\n    \"stability_confirmed\": true\r\n  },\r\n  \"diff_summary\": {\r\n    \"added_count\": 0,\r\n    \"modified_count\": 1,\r\n    \"removed_count\": 0,\r\n    \"added\": [],\r\n    \"modified\": [\r\n      {\r\n        \"key\": {\r\n          \"api_version\": \"rbac.authorization.k8s.io/v1\",\r\n          \"kind\": \"ClusterRole\",\r\n          \"namespace\": \"\",\r\n          \"name\": \"webapp-reader\"\r\n        },\r\n        \"changes\": [\r\n          {\r\n            \"path\": \"$.rules\",\r\n            \"baseline\": [\r\n              {\r\n                \"apiGroups\": [\r\n                  \"\"\r\n                ],\r\n                \"resources\": [\r\n                  \"pods\",\r\n                  \"services\"\r\n                ],\r\n                \"verbs\": [\r\n                  \"get\",\r\n                  \"list\",\r\n                  \"watch\"\r\n                ]\r\n              }\r\n            ],\r\n            \"candidate\": [\r\n              {\r\n                \"apiGroups\": [\r\n                  \"*\"\r\n                ],\r\n                \"resources\": [\r\n                  \"*\"\r\n                ],\r\n                \"verbs\": [\r\n                  \"*\"\r\n                ]\r\n              }\r\n            ]\r\n          }\r\n        ]\r\n      }\r\n    ],\r\n    \"removed\": []\r\n  },\r\n  \"security_findings\": [\r\n    {\r\n      \"rule_id\": \"RBAC-001\",\r\n      \"severity\": \"CRITICAL\",\r\n      \"object\": {\r\n        \"api_version\": \"\",\r\n        \"kind\": \"ClusterRole\",\r\n        \"namespace\": \"\",\r\n        \"name\": \"webapp-reader\"\r\n      },\r\n      \"json_path\": \"$.rules[0].resources\",\r\n      \"message\": \"wildcard (*) in resources grants access to all resource types\",\r\n      \"verdict_contribution\": \"BLOCK\",\r\n      \"pre_existing\": false,\r\n      \"evaluator\": \"conftest\"\r\n    },\r\n    {\r\n      \"rule_id\": \"RBAC-002\",\r\n      \"severity\": \"CRITICAL\",\r\n      \"object\": {\r\n        \"api_version\": \"\",\r\n        \"kind\": \"ClusterRole\",\r\n        \"namespace\": \"\",\r\n        \"name\": \"webapp-reader\"\r\n      },\r\n      \"json_path\": \"$.rules[0].verbs\",\r\n      \"message\": \"wildcard (*) in verbs grants all operations\",\r\n      \"verdict_contribution\": \"BLOCK\",\r\n      \"pre_existing\": false,\r\n      \"evaluator\": \"conftest\"\r\n    }\r\n  ],\r\n  \"evidence\": {\r\n    \"completeness\": \"COMPLETE\",\r\n    \"limitations\": [],\r\n    \"helm_exit_code_baseline\": 0,\r\n    \"helm_exit_code_candidate\": 0\r\n  },\r\n  \"fingerprint\": \"67c8f02774972c195947d2e4183295c9372bb96c8cbc92f042a689191d862010\",\r\n  \"run_metadata\": {\r\n    \"agent_session_id\": null,\r\n    \"human_runnable\": true,\r\n    \"no_cluster_credentials\": true,\r\n    \"no_deployment_occurred\": true\r\n  }\r\n}\r\n"]
