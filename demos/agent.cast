[0.009651, "o", "\u001b[H\u001b[2J\u001b[3J\u001b[1m\r\n"]
[0.010442, "o", "  ╔══════════════════════════════════════════════════════════════╗\r\n  ║      AI Agent  ×  helm-agent-preflight  Demonstration       ║\r\n  ║                                                              ║\r\n  ║   AI proposes · Helm renders · Rego evaluates · Human OKs   ║\r\n  ╚══════════════════════════════════════════════════════════════╝\r\n"]
[0.010564, "o", "\u001b[0m\r\n  \u001b[2mSKILL.md protocol: the agent runs the tool — it never invents the verdict.\u001b[0m\r\n  \u001b[2mThe fingerprint in the agent's report must match the tool's JSON.\u001b[0m\r\n\r\n"]
[0.010618, "o", "\r\n\u001b[0;34m\u001b[1m══ The Agent's Operating Rules (from SKILL.md) ══\u001b[0m\r\n\r\n\u001b[2m  Excerpt from skills/helm-preflight/SKILL.md:\u001b[0m\r\n"]
[0.01067, "o", "\r\n"]
[0.010691, "o", "\u001b[1m  Mandatory protocol:\u001b[0m\r\n  \u001b[2m• NEVER substitute tool output with AI reasoning\u001b[0m\r\n  \u001b[2m• You MUST run the tool and report its verdict\u001b[0m\r\n  \u001b[2m• If the tool cannot run, verdict is INDETERMINATE (treat as BLOCK)\u001b[0m\r\n"]
[0.010743, "o", "  \u001b[2m• Do NOT proceed when evidence.completeness is \"PARTIAL\"\u001b[0m\r\n  \u001b[2m• Do NOT modify the policy file solely to suppress a finding\u001b[0m\r\n\r\n"]
[0.01088, "o", "\r\n\u001b[0;34m\u001b[1m══ Simulated Agent Session — RBAC Escalation Scenario ══\u001b[0m\r\n\r\n"]
[0.010918, "o", "\u001b[1;33m\u001b[1m  👤 Human:\u001b[0m Qualify the Helm upgrade from rbac-escalation/baseline to rbac-escalation/candidate\r\n"]
[0.010939, "o", "\u001b[1;33m\u001b[1m  👤 Human:\u001b[0m Release: demo-app  |  Namespace: default  |  Kubernetes: 1.28\r\n\r\n"]
[0.010972, "o", "\u001b[0;35m\u001b[1m  🤖 Agent:\u001b[0m I will follow the helm-preflight skill protocol.\r\n"]
[0.011013, "o", "\u001b[0;35m\u001b[1m  🤖 Agent:\u001b[0m Step 1: Gather required inputs — ✔ all provided\r\n\u001b[0;35m\u001b[1m  🤖 Agent:\u001b[0m Step 2: Run helm preflight upgrade\r\n"]
[0.011026, "o", "\r\n\u001b[2m  $ preflight upgrade \\033[0m\r\n\u001b[2m      --from examples/rbac-escalation/baseline \\033[0m\r\n"]
[0.011058, "o", "\u001b[2m      --to   examples/rbac-escalation/candidate \\033[0m\r\n"]
[0.011093, "o", "\u001b[2m      --release-name demo-app --namespace default --kube-version 1.28 \\033[0m\r\n"]
[0.011116, "o", "\u001b[2m      --output-file demo-agent-reports/rbac.json\u001b[0m\r\n\r\n"]
[0.196864, "o", "\u001b[0;36m\u001b[1m  🔧 Tool:\u001b[0m  preflight exited with code 2 (2 = BLOCK)\r\n\r\n\u001b[0;35m\u001b[1m  🤖 Agent:\u001b[0m Step 3: Parse and report the verdict\r\n\r\n"]
[0.209733, "o", "  \u001b[1mVerdict\u001b[0m     : \u001b[0;31m\u001b[1mBLOCK\u001b[0m\r\n"]
[0.209746, "o", "  \u001b[1mFingerprint\u001b[0m : \u001b[2m80483bd4091749dd4b4f...\u001b[0m  \u001b[2m(tamper-evident, excludes timestamps)\u001b[0m\r\n  \u001b[1mTool\u001b[0m        : \u001b[2mv0.1.0-dev\u001b[0m\r\n"]
[0.20984, "o", "  \u001b[1mFindings\u001b[0m    : 2\r\n\r\n"]
[0.212476, "o", "    [BLOCK] RBAC-001 (CRITICAL) — ClusterRole/demo-app-reader\r\n      wildcard (*) in resources grants access to all resource types\r\n      pre_existing=false\r\n    [BLOCK] RBAC-002 (CRITICAL) — ClusterRole/demo-app-reader\r\n      wildcard (*) in verbs grants all operations\r\n      pre_existing=false\r\n"]
[0.212708, "o", "\r\n"]
[0.21272, "o", "\u001b[0;31m\u001b[1m  ✘  BLOCK\u001b[0m — Upgrade must not proceed\r\n"]
[0.212806, "o", "\r\n\u001b[0;35m\u001b[1m  🤖 Agent:\u001b[0m Step 4: Propose the smallest fix\r\n\r\n  \u001b[1mFinding RBAC-001/002:\u001b[0m ClusterRole uses wildcard (*) resources and verbs.\r\n  \u001b[1mProposed fix:\u001b[0m Replace wildcard rules with an explicit allowlist:\r\n\r\n  \u001b[2m  rules:\u001b[0m\r\n"]
[0.212851, "o", "  \u001b[2m    - apiGroups: [\"\"]\u001b[0m\r\n"]
[0.212878, "o", "  \u001b[2m      resources: [\"pods\", \"services\", \"configmaps\"]  # explicit, not *\u001b[0m\r\n  \u001b[2m      verbs:     [\"get\", \"list\", \"watch\"]             # explicit, not *\u001b[0m\r\n\r\n"]
[0.212904, "o", "\u001b[0;35m\u001b[1m  🤖 Agent:\u001b[0m Re-running preflight against the SAFE chart to confirm the fix works...\r\n\r\n"]
