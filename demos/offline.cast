[14.47814, "o", "\u001b[1;39m{\r\n  \u001b[0m\u001b[1;34m\"verdict\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"BLOCK\"\u001b[0m\u001b[1;39m,\r\n  \u001b[0m\u001b[1;34m\"findings\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[1;39m[\r\n    \u001b[1;39m{\r\n      \u001b[0m\u001b[1;34m\"rule\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"RBAC-001\"\u001b[0m\u001b[1;39m,\r\n      \u001b[0m\u001b[1;34m\"object\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"ClusterRole/webapp-reader\"\u001b[0m\u001b[1;39m,\r\n      \u001b[0m\u001b[1;34m\"issue\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"wildcard (*) in resources grants access to all resource types\"\u001b[0m\u001b[1;39m\r\n    \u001b[1;39m}\u001b[0m\u001b[1;39m,\r\n    \u001b[1;39m{\r\n      \u001b[0m\u001b[1;34m\"rule\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"RBAC-002\"\u001b[0m\u001b[1;39m,\r\n      \u001b[0m\u001b[1;34m\"object\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"ClusterRole/webapp-reader\"\u001b[0m\u001b[1;39m,\r\n      \u001b[0m\u001b[1;34m\"issue\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"wildcard (*) in verbs grants all operations\"\u001b[0m\u001b[1;39m\r\n    \u001b[1;39m}\u001b[0m\u001b[1;39m\r\n  \u001b[1;39m]\u001b[0m\u001b[1;39m\r\n\u001b[1;39m}\u001b[0m\r\n"]
