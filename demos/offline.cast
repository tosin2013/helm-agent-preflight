[25.709398, "o", "\u001b[1;39m{\r\n  \u001b[0m\u001b[1;34m\"verdict\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"BLOCK\"\u001b[0m\u001b[1;39m,\r\n  \u001b[0m\u001b[1;34m\"findings\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[1;39m[\r\n    \u001b[1;39m{\r\n      \u001b[0m\u001b[1;34m\"rule\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"WORK-001\"\u001b[0m\u001b[1;39m,\r\n      \u001b[0m\u001b[1;34m\"severity\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"CRITICAL\"\u001b[0m\u001b[1;39m,\r\n      \u001b[0m\u001b[1;34m\"issue\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"container 'worker' runs privileged (securityContext.privileged=true)\"\u001b[0m\u001b[1;39m,\r\n      \u001b[0m\u001b[1;34m\"new\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"newly introduced\"\u001b[0m\u001b[1;39m\r\n    \u001b[1;39m}\u001b[0m\u001b[1;39m\r\n  \u001b[1;39m]\u001b[0m\u001b[1;39m\r\n\u001b[1;39m}\u001b[0m\r\n"]
